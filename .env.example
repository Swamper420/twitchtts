# TwitchTTS Server Settings
PORT=8000
HOST=0.0.0.0

# Chatterbox TTS API Settings
CHATTERBOX_API_URL=http://localhost:8080/api/tts
CHATTERBOX_API_MODEL=default
CHATTERBOX_DEFAULT_VOICE=default
DEFAULT_AUDIO_FORMAT=ogg

# Twitch Chat Integration
TWITCH_CHANNEL=your_channel_name
TWITCH_BOT_NICK=justinfan12345
TWITCH_OAUTH_TOKEN=
TWITCH_READ_ALL_CHAT=true

# Queue & Filtering
MAX_QUEUE_SIZE=100
MAX_TEXT_LENGTH=400
ENABLE_SPAM_FILTER=true
ENABLE_URL_FILTER=true
